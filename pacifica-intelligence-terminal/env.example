# Pacifica Intelligence Terminal Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Pacifica API Configuration
PACIFICA_WS_URL=wss://api.pacifica.io/ws
PACIFICA_API_URL=https://api.pacifica.io
PACIFICA_API_KEY=your_pacifica_api_key_here
PACIFICA_TESTNET=true

# Trading Configuration
MAX_POSITION_SIZE=100000
RISK_TOLERANCE=medium
AUTO_EXECUTION=false

# Default symbols to monitor
DEFAULT_SYMBOLS=BTC-PERP,ETH-PERP,SOL-PERP,AVAX-PERP

# Risk Management
MAX_LEVERAGE=10
MIN_LIQUIDATION_DISTANCE=0.05
VOLATILITY_MULTIPLIER=2.0

# Signal Configuration
SIGNAL_CONFIDENCE_THRESHOLD=0.7
SIGNAL_STRENGTH_THRESHOLD=0.6
MAX_SIGNALS_DISPLAY=20

# Update Intervals (milliseconds)
WEBSOCKET_UPDATE_INTERVAL=1000
SIGNAL_UPDATE_INTERVAL=5000
POSITION_UPDATE_INTERVAL=3000
CHART_UPDATE_INTERVAL=10000

# Dashboard Configuration
DASHBOARD_REFRESH_INTERVAL=5000
CHART_ANIMATION_DURATION=750
NOTIFICATION_DURATION=3000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/pacifica-terminal.log

# Security
CORS_ORIGIN=*
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Features
ENABLE_REAL_TIME_CHARTS=true
ENABLE_AUTO_EXECUTION=false
ENABLE_RISK_ALERTS=true
ENABLE_PERFORMANCE_TRACKING=true

# Database (if using persistent storage)
DATABASE_URL=sqlite:./pacifica-terminal.db
REDIS_URL=redis://localhost:6379

# External Services
COINGECKO_API_KEY=your_coingecko_api_key
NEWS_API_KEY=your_news_api_key
TWITTER_API_KEY=your_twitter_api_key

# Machine Learning
ML_MODEL_PATH=models/
ENABLE_ML_SIGNALS=false
ML_CONFIDENCE_THRESHOLD=0.8

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000
